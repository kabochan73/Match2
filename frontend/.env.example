# Base URL the browser uses to call the Laravel API directly.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Base URL the Next.js server (Server Components, SSR fetches) uses to
# call the Laravel API. Inside docker-compose this should be the
# backend service's internal address (http://app:8080) instead of the
# host-mapped port, since the two containers talk over the compose
# network. Defaults to NEXT_PUBLIC_API_URL when unset.
API_INTERNAL_URL=http://app:8080

# This site's own public origin. Sent as the Origin header on
# server-side API fetches so Laravel Sanctum's
# EnsureFrontendRequestsAreStateful middleware recognizes the request
# as coming from the SPA (must match a SANCTUM_STATEFUL_DOMAINS entry).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
